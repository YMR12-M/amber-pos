# ============================================================================
# عنبر POS — إعدادات السيرفر
#
#   cp .env.example .env    ثم املا القيم اللي تحت
#
# الملف ده مثال بيتحفظ في المستودع. ملف `.env` نفسه **مش** بيترفع
# (مكتوب في .gitignore) — فيه مفاتيح حقيقية.
# ============================================================================

# development أثناء الشغل · production على السيرفر
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# قاعدة البيانات
#
# في الإنتاج: اعمل مستخدم مخصّص للنظام بصلاحيات على قاعدته بس، مش root.
#   CREATE USER 'amber'@'localhost' IDENTIFIED BY '<كلمة مرور قوية>';
#   GRANT ALL PRIVILEGES ON pos_system.* TO 'amber'@'localhost';
# السيرفر بيرفض يشتغل في الإنتاج بكلمة مرور فاضية.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_system

# ---------------------------------------------------------------------------
# مفتاح توقيع الجلسات — إجباري، والتطبيق بيرفض يشتغل من غيره.
# ولّد واحد جديد لكل تنصيب:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# لو غيّرته، كل الجلسات المفتوحة بتنتهي (الموظفين بيدخلوا تاني).
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# الواجهة
#
# SERVE_STATIC=true  → السيرفر بيقدّم نسخة الواجهة المبنيّة بنفسه.
#   ده الافتراضي في الإنتاج وأبسط طريقة للنشر: أصل واحد، مفيش CORS،
#   والكوكي بتفضل SameSite=Strict. ابنِ الواجهة الأول:
#     cd frontend && npm run build
#
# سيبها فاضية أثناء التطوير — Vite بيشغّل الواجهة على 5173 وبيمرّر
# /api للسيرفر ده.
# ---------------------------------------------------------------------------
# SERVE_STATIC=true
# STATIC_DIR=/var/www/amber-pos/frontend/dist

# الدومينات المسموح لها (مفصولة بفاصلة). مطلوبة بس لو الواجهة على
# دومين تاني غير الـ API. "*" مرفوضة — الكوكي مش بتتبعت لأصل عام.
CORS_ORIGIN=http://localhost:5173

# لو الواجهة على دومين مختلف عن الـ API، المتصفح مش هيبعت كوكي Strict،
# فلازم تحطها none (وده بيفرض HTTPS). سيبها strict لو نفس الأصل.
# COOKIE_SAMESITE=strict

# ---------------------------------------------------------------------------
# قواعد العمل
# ---------------------------------------------------------------------------
# أقصى نسبة ضريبة مسموح للأدمن يحطها من لوحة التحكم (0.5 = 50%)
MAX_TAX_RATE=0.5

# سقف نداءات الـ API لكل IP في الدقيقة.
# محل كامل بيطلّع من IP واحد (نفس الراوتر)، فالرقم ده للمحل مش للجهاز.
# 600 بتسع أجهزة كتير؛ زوّدها لو عندك فروع كبيرة ورا نفس الخط.
API_RATE_LIMIT=600

# ---------------------------------------------------------------------------
# تجهيز أول حساب أدمن من غير أسئلة (Docker · CI · سيرفر بعيد).
# سيبهم فاضيين وشغّل `npm run setup` من الطرفية عشان يسألك بنفسه.
# امسحهم من الملف بعد أول تشغيل.
# ---------------------------------------------------------------------------
# SETUP_ADMIN_NAME=
# SETUP_ADMIN_EMAIL=
# SETUP_ADMIN_PASSWORD=
